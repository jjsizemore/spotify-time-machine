{
  "name": "jermaines-spotify-time-machine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "commit": "commit",
    "clean": "rm -rf .next node_modules/.cache && rm -rf node_modules && pnpm store prune",
    "clean:cache": "rm -rf .next node_modules/.cache .turbo",
    "clean:all": "rm -rf .next node_modules/.cache .turbo node_modules && pnpm store prune",
    "debug": "pnpm run clean:all && pnpm install && pnpm run build && pnpm run dev",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint $@ && eslint $@",
    "lint:fix": "oxlint --fix $@ && eslint --fix $@",
    "fmt": "pnpm exec prettier --check .",
    "fmt:fix": "pnpm exec prettier --write .",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "check": "turbo lint type-check",
    "check:branding": "grep -RIn --exclude-dir=.next --exclude=**/output.css --exclude=**/*.svg --exclude=BRANDING.md '#1db954\\|#1DB954\\|#191414\\|#121212\\|#b3b3b3' src || true",
    "check:all": "turbo lint fmt type-check",
    "security": "mise run security",
    "security:secrets": "trufflehog filesystem . --no-update --fail --exclude-paths=.trufflehog-exclude.txt",
    "security:deps": "snyk test --all-projects",
    "security:sast": "semgrep --config semgrep.yml src",
    "security:env": "dotenv-linter .env.example",
    "spellcheck": "typos",
    "audit": "mise run audit",
    "badges:update": "node scripts/update-readme-badges.js",
    "postinstall": "pnpm run badges:update",
    "version": "pnpm run badges:update && git add README.md"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.9",
    "@sentry/nextjs": "^10.58.0",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "flowbite": "^4.0.2",
    "flowbite-react": "^0.12.17",
    "helmet": "^8.2.0",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.6.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/prompt-cli": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@prettier/plugin-oxc": "^0.1.4",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxlint": "^1.70.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "lefthook": "^2.1.9",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.1",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.0.4"
}
